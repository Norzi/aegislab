# Copy to /etc/sing-box/autopilot.env and fill in. Keep it private: chmod 600.
SUB_URL=https://YOUR_PROVIDER/sub/YOUR_SUBSCRIPTION_TOKEN
HWID=YOUR_DEVICE_ID
USER_AGENT=YOUR_CLIENT_APP/1.0
SUB_HOST=YOUR_PROVIDER_HOST

# Path 2: a fixed vless:// link (the node that path 2 stays on)
FIXED_URI=vless://YOUR_UUID@YOUR_SERVER_IP:443?encryption=none&type=ws&host=YOUR_HOST&path=/&security=tls&fp=chrome&sni=YOUR_SNI#my-fixed-node
