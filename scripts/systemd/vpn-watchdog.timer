[Unit]
Description=Run vpn-watchdog every 2 minutes

[Timer]
# first check after boot comes after sing-box and the first autopilot run had time to start
OnBootSec=5min
OnUnitActiveSec=2min
# default accuracy is 1 min, which would blur a 2-min cadence
AccuracySec=10s

[Install]
WantedBy=timers.target
